<IfModule mod_rewrite.c>
    RewriteEngine On

    # 301 Redirect any direct request hitting /public/ to the clean URL
    RewriteCond %{THE_REQUEST} \s/+public/([^\s?]*) [NC]
    RewriteRule ^ /%1 [L,R=301]

    # Direct all incoming traffic to the /public directory on Hostinger/cPanel
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
